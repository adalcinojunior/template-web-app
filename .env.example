#################################################################################################
#######################################  EXECUTION SETUP  #######################################
#################################################################################################

# VITE_PORT          Port used by the application to listen to HTTP requests in a development environment.
#                    default value: 3000.
VITE_PORT=3000

# VITE_TITLE           Application title
#                           default value: Template Web-app
VITE_TITLE=Template Web-App

# VITE_DESCRIPTION     Application description
#                           default value:Projeto base para criação de aplicações web usando react+mui+redux toolkit+i18next.
VITE_DESCRIPTION=Projeto base para criação de aplicações web usando react+mui+redux toolkit+i18next.

# VITE_API_GATEWAY     URI used to connect to the API GATEWAY public API.
#                           default value: https://localhost:8081
VITE_API_GATEWAY=https://localhost:8081

#################################################################################################
##############################  AUTHORIZATION/AUTHENTICATION SETUP ##############################
#################################################################################################

# VITE_ISSUER:           Issuer used to generate the JWT token
#                             default value: issuer
VITE_ISSUER=issuer

# VITE_JWT_PUBLIC_KEY:   Public key for validating the jwt token.
#                             default value: -----BEGIN RSA PUBLIC KEY----------END RSA PUBLIC KEY-----
VITE_JWT_PUBLIC_KEY=-----BEGIN RSA PUBLIC KEY----------END RSA PUBLIC KEY-----

#################################################################################################
####################################### CERTIFICATES/KEYS #######################################
#################################################################################################

# SSL_KEY_PATH:             Private key for SSL certificate
#                           default value: .certs/server_key.pem
#
#                           To generate self-signed certificates,
#                           see: https://devcenter.heroku.com/articles/ssl-certificate-self
SSL_KEY_PATH=.certs/server_key.pem

# SSL_CERT_PATH:            Certificate SSL
#                           default value: .certs/server_cert.pem
#
#                           To generate self-signed certificates,
#                           see: https://devcenter.heroku.com/articles/ssl-certificate-self
SSL_CERT_PATH=.certs/server_cert.pem
